[Unit]
Description=SAP HANA database metrics exporter
Documentation=https://github.com/SUSE/hanadb_exporter

[Service]
Type=notify
User=prometheus
Group=prometheus
ExecStart=/usr/bin/hanadb_exporter --identifier %i --daemon
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=full

[Install]
WantedBy=multi-user.target
